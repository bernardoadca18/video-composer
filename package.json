{
  "name": "neovids-video-composer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "smoke:render": "tsx scripts/smoke-render.ts",
    "benchmark": "tsx scripts/benchmark-render.ts",
    "extract:frames": "tsx scripts/extract-frames.ts",
    "cache:cleanup": "tsx scripts/cleanup-cache.ts",
    "outputs:cleanup": "tsx scripts/cleanup-outputs.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.516",
    "@remotion/cli": "4.0.516",
    "@remotion/renderer": "4.0.516",
    "better-sqlite3": "12.4.1",
    "fastify": "5.12.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.516",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.25",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "10.0.0",
    "prettier": "3.9.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
